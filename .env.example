# ==============================================================================
# KRONOS V12 STANDALONE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to .env on your instance: cp .env.example .env
# 2. Set your environment variables below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS REGION (CRITICAL: DO NOT USE US REGIONS)
# ------------------------------------------------------------------------------
# Binance Futures API refuses all requests from US IP addresses (HTTP 451 error).
# Therefore, your AWS EC2 instance MUST be launched in an EU or Asia-Pacific region.
# Recommended regions:
#   - eu-central-1 (Frankfurt, Germany) [RECOMMENDED]
#   - eu-west-1    (Ireland)
#   - ap-northeast-1 (Tokyo, Japan)
AWS_DEFAULT_REGION=eu-central-1

# ------------------------------------------------------------------------------
# 2. S3 LEDGER & ARTIFACT BACKUP
# ------------------------------------------------------------------------------
# After every hourly run, canonical trades.parquet, scorecard.parquet, sync_state.json,
# and tear sheets will be synchronized to this bucket under v12_production/.
# Leave empty on localhost to run purely on local disk without errors.
S3_BUCKET=

# ------------------------------------------------------------------------------
# 3. DEAD-MAN'S SWITCH / MONITORING HEARTBEAT
# ------------------------------------------------------------------------------
# If the EC2 host freezes, crashes, or reboots, an on-box script cannot send an email.
# To detect a dead server, register a free check at https://healthchecks.io or Cronitor
# with a 70-minute period and paste the ping URL here.
# Leave empty on localhost to skip heartbeat pings.
HEARTBEAT_URL=

# Optional: Enable CloudWatch custom metric emission ('KronosV12' -> 'PipelineHeartbeat=1')
# Requires EC2 IAM role with cloudwatch:PutMetricData permission.
ENABLE_CLOUDWATCH_HEARTBEAT=0

# ------------------------------------------------------------------------------
# 4. BINANCE API KEYS — COMPLETELY OPTIONAL (NOT USED BY MAIN PIPELINE)
# ------------------------------------------------------------------------------
# The entire Kronos V12 pipeline uses ONLY public Binance Futures endpoints:
#   /fapi/v1/klines                        → OHLCV candles       (public, no key)
#   /fapi/v1/premiumIndex                  → Funding time cache   (public, no key)
#   /fapi/v1/fundingRate                   → Funding rate history (public, no key)
#   /futures/data/openInterestHist         → OI history           (public, no key)
#   /futures/data/topLongShortAccountRatio → Top Trader L/S ratio (public, no key)
#
# API keys are ONLY required if you run scripts/reconcile_positions.py
# to verify that your ledger matches your live exchange positions.
# Leave blank to skip reconciliation — main pipeline runs with zero keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ------------------------------------------------------------------------------
# 5. DASHBOARD CONFIGURATION
# ------------------------------------------------------------------------------
# On AWS EC2, set NICEGUI_HOST=0.0.0.0 to allow external browser access.
# On localhost Windows, NiceGUI defaults to 127.0.0.1 (localhost only).
NICEGUI_HOST=0.0.0.0
NICEGUI_PORT=8056

# ------------------------------------------------------------------------------
# 6. HEALTH MONITOR THRESHOLDS (Fix #1, #2 — Stale Data & Disk Guard)
# ------------------------------------------------------------------------------
# Alert if the newest raw shard is older than this many hours (Stale Data Guard)
HEALTH_STALE_HOURS=2
# Warn when disk usage exceeds this percentage
HEALTH_DISK_WARN_PCT=80
# Hard-stop pipeline (abort parquet writes) when disk exceeds this percentage
HEALTH_DISK_CRIT_PCT=92

# ------------------------------------------------------------------------------
# 7. DISK CLEANUP RETENTION (Fix #2 — Disk Full Guard)
# ------------------------------------------------------------------------------
# Keep arm experiment folders for this many days before auto-cleaning
# (Production arm 'v12_production' is NEVER deleted regardless of this setting)
CLEANUP_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 8. AWS SNS TRADE SIGNAL EMAIL ALERTS (OPTIONAL)
# ------------------------------------------------------------------------------
# Whenever new entry signals trigger, dispatch formatted trade alerts to this SNS Topic.
# Create an AWS SNS standard topic with email subscription and paste the ARN here:
SNS_TOPIC_ARN=
# 1 = only dispatch emails when NEW signals trigger (recommended to avoid hourly noise)
# 0 = dispatch an hourly portfolio status digest every hour
NOTIFY_ONLY_ON_NEW_SIGNALS=1
# Optional: Public URL of your dashboard (e.g. http://54.93.x.x:8056 or domain) to link in emails
DASHBOARD_URL=
