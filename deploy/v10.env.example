# On EC2, deploy/aws/bootstrap.sh writes this file to /etc/v10/v10.env for you.
# For a manual install, copy it there. Do not commit a filled-in copy.
# Binance futures refuses US IP addresses (HTTP 451): run this outside the US.
AWS_DEFAULT_REGION=eu-west-2

# Data directory (shards, state, tapes).
V10_DATA_ROOT=/var/lib/v10/data

# Hourly report via SNS (email subscribers confirm once). Role needs sns:Publish.
V10_SNS_TOPIC_ARN=
# Alternative: SES (used only if V10_SNS_TOPIC_ARN is empty).
# V10_SES_FROM=
# V10_ALERT_TO=
# V10_SES_REGION=eu-west-2

# S3 backup (instance role needs s3:PutObject/GetObject/ListBucket on it).
V10_BACKUP_BUCKET=
V10_BACKUP_PREFIX=v10
V10_DATA_BACKUP_HOUR=2

# CloudWatch heartbeat (instance role needs cloudwatch:PutMetricData).
V10_CW_NAMESPACE=V10

# Binance pacing (requests/second). Defaults sit under the published limits.
# V10_FUTDATA_RPS=3.0   # OI hist + L/S ratio: 1000 req / 5 min / IP
# V10_FUNDING_RPS=1.5   # fundingRate: 500 req / 5 min / IP
# V10_KLINE_RPS=10      # weight budget 2400 / min / IP
