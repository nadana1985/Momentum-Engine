[Unit]
Description=Kronos V12 Universal Momentum Engine Hourly Pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/kronos_v12
ExecStart=/bin/bash /home/ubuntu/kronos_v12/pipeline_v12.sh
StandardOutput=journal
StandardError=journal
# 3 = previous run still holding flock; not a failure
SuccessExitStatus=3

# Fix #5 — OOM Killer protection: Tuned for t4g.medium (4 GB RAM + 4 GB swap)
# Allocates up to 3.4 GB physical RAM before paging to swap, leaving 600 MB for OS & Dashboard
MemoryMax=3.4G
MemorySwapMax=2.5G

# Fix #4 — Limit logs this service can produce per run
LogRateLimitIntervalSec=60
LogRateLimitBurst=3000

# Timeout: 30 minutes max for full pipeline (bridger + backtest + artifacts)
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
