# Auto-detect text files and normalize line endings
* text=auto

# Code and text configurations
*.py text eol=lf
*.md text
*.txt text
*.json text
*.html text
*.yml text
*.yaml text

# Linux systemd units and shell scripts (require LF)
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary formats
*.parquet binary
*.png binary
*.jpg binary
*.ico binary
